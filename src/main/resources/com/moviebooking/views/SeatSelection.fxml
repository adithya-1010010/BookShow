<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.moviebooking.controller.SeatSelectionController"
            styleClass="app-shell"
            prefHeight="700.0"
            prefWidth="1060.0">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-bar">
            <children>
                <Button onAction="#handleBack" text="Back" styleClass="ghost-button" />
                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="titleLabel" text="Select Your Seats" styleClass="screen-title" />
                        <Label fx:id="subtitleLabel" styleClass="screen-subtitle" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <content>
                <VBox alignment="CENTER" spacing="16.0" styleClass="screen-body">
                    <children>
                        <Label text="SCREEN" styleClass="section-label" />
                        <Region fx:id="screenLine" styleClass="screen-line"
                                maxWidth="520.0" prefWidth="520.0" prefHeight="6.0" />
                        <GridPane fx:id="seatGrid" hgap="9.0" vgap="9.0" alignment="CENTER" />
                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <StackPane styleClass="seat-legend">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Region styleClass="legend-swatch, legend-available" />
                                                <Label text="Available" styleClass="chip-text" />
                                            </children>
                                        </HBox>
                                    </children>
                                </StackPane>
                                <StackPane styleClass="seat-legend">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Region styleClass="legend-swatch, legend-selected" />
                                                <Label text="Selected" styleClass="chip-text" />
                                            </children>
                                        </HBox>
                                    </children>
                                </StackPane>
                                <StackPane styleClass="seat-legend">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Region styleClass="legend-swatch, legend-booked" />
                                                <Label text="Booked" styleClass="chip-text" />
                                            </children>
                                        </HBox>
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="footer-bar">
            <children>
                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="countLabel" text="0 seats selected" styleClass="value-text" />
                        <Label fx:id="totalLabel" styleClass="inline-note" />
                    </children>
                </VBox>
                <Label fx:id="errorLabel" styleClass="error-label" />
                <Button fx:id="continueButton" onAction="#handleContinue" disable="true"
                        text="Continue" styleClass="primary-button" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
