<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.moviebooking.controller.ShowSelectionController"
            styleClass="app-shell"
            prefHeight="700.0"
            prefWidth="1060.0">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-bar">
            <children>
                <Button onAction="#handleBack" text="Back" styleClass="ghost-button" />
                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="titleLabel" text="Select a Show" styleClass="screen-title" />
                        <Label fx:id="subtitleLabel" styleClass="screen-subtitle" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <content>
                <VBox fx:id="showContainer" spacing="12.0" styleClass="screen-body">
                    <children />
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="footer-bar">
            <children>
                <Label fx:id="hintLabel" styleClass="muted" HBox.hgrow="ALWAYS" />
                <Button fx:id="continueButton" onAction="#handleContinue" disable="true"
                        text="Continue" styleClass="primary-button" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
