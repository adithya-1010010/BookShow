<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.moviebooking.controller.MovieListController"
            styleClass="app-shell"
            prefHeight="700.0"
            prefWidth="1060.0">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-bar">
            <children>
                <Button onAction="#handleBack" text="Back" styleClass="ghost-button" />
                <VBox spacing="1.0">
                    <children>
                        <Label text="Now Showing" styleClass="screen-title" />
                        <Label fx:id="subtitleLabel" styleClass="screen-subtitle" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <content>
                <FlowPane fx:id="cardContainer" hgap="18.0" vgap="18.0" styleClass="screen-body">
                    <children />
                </FlowPane>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="footer-bar">
            <children>
                <Label fx:id="footerLabel" styleClass="muted" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
