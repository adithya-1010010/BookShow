<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.moviebooking.controller.HomeController"
           styleClass="app-shell"
           prefHeight="700.0"
           prefWidth="1060.0">
    <children>
        <VBox alignment="CENTER" spacing="18.0" styleClass="screen-body">
            <children>
                <Label text="BOOKSHOW" styleClass="brand" />
                <Label text="Movie Ticket Booking" styleClass="hero-title" />
                <Label text="Pick a movie, choose your seats, and book in seconds."
                       styleClass="hero-subtitle" wrapText="true" maxWidth="520.0" />
                <VBox alignment="CENTER" spacing="7.0">
                    <children>
                        <Button fx:id="browseButton" onAction="#handleBrowse"
                                text="Browse Movies" styleClass="primary-button" />
                        <Label fx:id="statusLabel" styleClass="inline-note" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
